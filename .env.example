# =============================================================
# D&D Meta Game - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# Only PORT is required. Everything else has sensible defaults.

# Server port (default: 3000)
PORT=3000

# =============================================================
# AI: the local model, through Ollama (no API key, no internet)
# =============================================================
# The whole game runs on a model served by Ollama on this PC.
# Install Ollama from https://ollama.com, then: ollama pull gemma4:12b
#
# Every AI call names a ROLE; each role resolves to a model.
# All roles default to gemma4:12b (server/services/localModels.js).
#
# Where Ollama is listening (default http://localhost:11434):
# OLLAMA_URL=http://localhost:11434
#
# One model for every role (default gemma4:12b):
# OLLAMA_MODEL=gemma4:12b
#
# Optional per-role overrides — dm (narrative turns), summary,
# extraction (chronicles, notes, NPCs), generation (plans, quests,
# locations, companions):
# OLLAMA_MODEL_DM=
# OLLAMA_MODEL_SUMMARY=
# OLLAMA_MODEL_EXTRACTION=
# OLLAMA_MODEL_GENERATION=
#
# Context window sent to Ollama on every call, in tokens (default 65536 —
# measured to fit gemma4:12b fully on a 16 GB GPU). Lower it on a smaller GPU.
# OLLAMA_NUM_CTX=65536
#
# Model "thinking" before it answers (default off — it slows every turn):
# OLLAMA_THINK=false
#
# Ceiling on one DM reply, in tokens (default 4000):
# DM_MAX_TOKENS=4000

# =============================================================
# Database Configuration
# =============================================================
# By default, uses a local SQLite file (local.db) in the project root.
# No configuration needed for local development.
#
# For cloud sync across devices, configure Turso:
# Get credentials from https://turso.tech after creating a database.
# Then run: npm run migrate-to-cloud
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-auth-token
